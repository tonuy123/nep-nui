# Credentials cho demo local — COPY file nay thanh demo.env roi dien gia tri.
# demo.env KHONG duoc commit (da nam trong .gitignore).
# Huong dan tung buoc: docs/OAUTH_CAPTCHA_SETUP.md

# --- Google OAuth (console.cloud.google.com) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth (developers.facebook.com) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Secret ky state OAuth (>= 32 ky tu ngau nhien) ---
# Sinh bang: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=

# --- reCAPTCHA v2 checkbox (google.com/recaptcha/admin) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- SMTP cho quen mat khau (vi du: smtp://user:app-pass@smtp.gmail.com:587) ---
SMTP_URL=
MAIL_FROM=
