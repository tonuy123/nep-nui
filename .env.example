# Mau bien moi truong - KHONG chua secret that.
# API doc process env truc tiep, khong tu dong nap file .env.
# Dat bien trong terminal PowerShell danh rieng truoc khi start:
#   $env:DATABASE_URL = 'postgresql://webdulich:webdulich_local@127.0.0.1:55432/webdulich_dev?schema=public'

# Web: server-only BFF upstream. KHONG dung NEXT_PUBLIC cho credential/upstream secrets.
API_INTERNAL_URL=http://127.0.0.1:3001
# Public content clients khac co the dung URL nay (P6).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api/v1

# API (NestJS)
PORT=3001

# PostgreSQL dev (compose.yaml, bind 127.0.0.1:55432)
DATABASE_URL=postgresql://webdulich:webdulich_local@127.0.0.1:55432/webdulich_dev?schema=public

# PostgreSQL test rieng cho integration tests (compose.yaml service postgres-test, bind 127.0.0.1:55433)
TEST_DATABASE_URL=postgresql://webdulich:webdulich_local@127.0.0.1:55433/webdulich_test?schema=public

# Cookie Secure = true khi NODE_ENV=production; production phai dung HTTPS.
# Local API development dung NODE_ENV=development; khong override production de bo Secure.
NODE_ENV=development

# CORS/CSRF Origin allowlist exact, comma-separated; khong wildcard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bootstrap ADMIN chi khi chu dong cap credential trong process env, khong seed mac dinh.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ==== P4c auth mo rong (tat ca optional; thieu => tinh nang tu an/bao chua cau hinh) ====
# SMTP gui email dat lai mat khau (vi du smtp://user:pass@smtp.example.com:587).
# Thieu SMTP_URL => POST /auth/forgot-password tra 503 MAIL_NOT_CONFIGURED.
SMTP_URL=
MAIL_FROM=

# reCAPTCHA v2 checkbox: dat du ca hai moi bat buoc xac minh.
# RECAPTCHA_SITE_KEY tra ve web qua /auth/config; RECAPTCHA_SECRET_KEY dung verify server-side.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# OAuth Google: tao OAuth client, redirect URI =
#   <WEB_ORIGIN>/api/backend/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth Facebook: redirect URI =
#   <WEB_ORIGIN>/api/backend/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Secret ky state OAuth (>= 32 ky tu ngau nhien). Thieu => OAuth coi nhu chua cau hinh.
OAUTH_STATE_SECRET=
